# Connection string de Postgres (Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secreto de NextAuth — generar con: npx auth secret
AUTH_SECRET=""

# Datos del usuario admin inicial, usados solo por `npx prisma db seed`
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""
SEED_ADMIN_PASSWORD=""
