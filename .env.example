# Connection string de Postgres para runtime (pooler, ej. Supabase transaction pooler
# puerto 6543 con ?pgbouncer=true, o Neon pooled connection).
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"

# Connection string directo/session-pooler (puerto 5432), usado por `prisma migrate`.
# En proveedores sin pooler (o si la conexión directa funciona) puede ser igual a DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Secreto de NextAuth — generar con: npx auth secret
AUTH_SECRET=""

# Datos del usuario admin inicial, usados solo por `npx prisma db seed`
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""
SEED_ADMIN_PASSWORD=""

# --- Reporte semanal por mail (opcional; sin esto el envío no funciona) ---

# Casilla de Gmail desde la que sale el mail. Tiene que ser la misma dirección que autentica:
# Gmail reescribe o rechaza un remitente distinto.
GMAIL_USER=""

# "Contraseña de aplicación" de 16 caracteres, NO la contraseña normal de la cuenta.
# Se genera en: Cuenta de Google -> Seguridad -> Verificación en dos pasos -> Contraseñas de
# aplicaciones (requiere tener activada la verificación en dos pasos).
GMAIL_APP_PASSWORD=""

# Token con el que Vercel Cron autentica el llamado a /api/cron/reporte-semanal. Vercel lo inyecta
# solo como header Authorization una vez que la variable existe en el proyecto.
# Generar con: openssl rand -hex 32
CRON_SECRET=""

# Destinatarios iniciales, separados por coma. Es solo el valor de arranque: una vez configurados
# desde Reportes -> "Reporte semanal", manda lo que se haya guardado ahí.
WEEKLY_REPORT_RECIPIENTS=""
