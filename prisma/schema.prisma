generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  CARGA_DIARIA
  SOLO_LECTURA
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents Document[]
  payments  Payment[]

  itemMovements    ItemMovement[]
  productMovements ProductMovement[]
  productionRuns   ProductionRun[]
  boxMovements     BoxMovement[]
  pallets          Pallet[]
  prices           Price[]
}

enum EntityType {
  CLIENTE
  PROVEEDOR
  AMBOS
}

model Entity {
  id                 String     @id @default(cuid())
  name               String
  type               EntityType
  taxId              String?
  contact            String?
  isWithholdingAgent Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  accounts           Account[]
  prices             Price[]
}

enum Circuit {
  BLANCO
  NEGRO
}

model Account {
  id        String   @id @default(cuid())
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id])
  circuit   Circuit
  createdAt DateTime @default(now())

  documents Document[]
  payments  Payment[]

  @@unique([entityId, circuit])
}

enum DocumentType {
  REMITO
  FACTURA
  NOTA_CREDITO
  NOTA_DEBITO
  AJUSTE
}

enum Currency {
  ARS
  USD
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  OTRO
}

model Document {
  id               String       @id @default(cuid())
  accountId        String
  account          Account      @relation(fields: [accountId], references: [id])
  type             DocumentType
  number           String
  date             DateTime
  dueDate          DateTime?
  currency         Currency     @default(ARS)
  exchangeRate     Decimal?     @db.Decimal(12, 4)
  netAmount        Decimal      @db.Decimal(14, 2)
  ivaRate          Decimal?     @db.Decimal(5, 2)
  ivaAmount        Decimal?     @db.Decimal(14, 2)
  retentionAmount  Decimal?     @db.Decimal(14, 2)
  perceptionAmount Decimal?     @db.Decimal(14, 2)
  totalAmount      Decimal      @db.Decimal(14, 2)
  reason           String?
  productId        String?
  product          Product?     @relation(fields: [productId], references: [id])
  quantity         Decimal?     @db.Decimal(14, 3)
  createdById      String
  createdBy        User         @relation(fields: [createdById], references: [id])
  createdAt        DateTime     @default(now())

  remitoLinks  DocumentLink[] @relation("RemitoLinks")
  facturaLinks DocumentLink[] @relation("FacturaLinks")
  allocations  PaymentAllocation[]
  lines        DocumentLine[]

  @@index([accountId])
}

model DocumentLine {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(14, 3)
  unitPrice  Decimal  @db.Decimal(14, 2)
  subtotal   Decimal  @db.Decimal(14, 2)

  @@index([documentId])
}

model DocumentLink {
  id        String   @id @default(cuid())
  remitoId  String
  remito    Document @relation("RemitoLinks", fields: [remitoId], references: [id])
  facturaId String
  factura   Document @relation("FacturaLinks", fields: [facturaId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)

  @@unique([remitoId, facturaId])
}

model Payment {
  id          String        @id @default(cuid())
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id])
  date        DateTime
  amount      Decimal       @db.Decimal(14, 2)
  currency    Currency      @default(ARS)
  method      PaymentMethod
  reference   String?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  allocations PaymentAllocation[]

  @@index([accountId])
}

model PaymentAllocation {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id])
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())

  @@unique([paymentId, documentId])
}

model Item {
  id           String   @id @default(cuid())
  name         String
  unit         String
  isResellable Boolean  @default(false)
  minStock     Decimal? @db.Decimal(14, 3)
  unitCost     Decimal? @db.Decimal(14, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movements   ItemMovement[]
  recipeLines RecipeItem[]

  palletsAsWood Pallet[] @relation("PalletWood")
  palletsAsFilm Pallet[] @relation("PalletFilm")
}

enum ItemMovementType {
  INGRESO
  CONSUMO_PRODUCCION
  CONSUMO_PALLET
  AJUSTE
  MERMA
  VENTA
}

model ItemMovement {
  id               String            @id @default(cuid())
  itemId           String
  item             Item              @relation(fields: [itemId], references: [id])
  date             DateTime
  quantity         Decimal           @db.Decimal(14, 3)
  type             ItemMovementType
  reason           String
  sourceKg         Decimal?          @db.Decimal(14, 3)
  conversionFactor Decimal?          @db.Decimal(10, 4)
  createdById      String
  createdBy        User              @relation(fields: [createdById], references: [id])
  createdAt        DateTime          @default(now())

  @@index([itemId])
}

model Product {
  id               String   @id @default(cuid())
  name             String
  oilType          String
  presentation     String
  boxesPerPallet   Int?
  unitsPerBox      Int?
  bottleCapacityMl Decimal? @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recipe          RecipeItem[]
  movements       ProductMovement[]
  productionLines ProductionLine[]
  boxTypes        BoxType[]
  documents       Document[]
  documentLines   DocumentLine[]
  prices          Price[]
}

model Setting {
  key   String @id
  value String
}

model RecipeItem {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item    @relation(fields: [itemId], references: [id])
  quantityPerUnit Decimal @db.Decimal(14, 4)

  @@unique([productId, itemId])
}

enum ProductMovementType {
  PRODUCCION
  CONSUMO_ARMADO_CAJA
  AJUSTE
  MERMA
}

model ProductMovement {
  id          String              @id @default(cuid())
  productId   String
  product     Product             @relation(fields: [productId], references: [id])
  date        DateTime
  quantity    Decimal             @db.Decimal(14, 3)
  type        ProductMovementType
  reason      String
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())

  @@index([productId])
}

model ProductionRun {
  id          String   @id @default(cuid())
  date        DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  lines ProductionLine[]
}

model ProductionLine {
  id              String        @id @default(cuid())
  productionRunId String
  productionRun   ProductionRun @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(14, 3)
}

model BoxType {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  unitsPerBox Decimal  @db.Decimal(14, 3)
  label       String
  createdAt   DateTime @default(now())

  movements   BoxMovement[]
  palletBoxes PalletBox[]
}

enum BoxMovementType {
  ARMADO
  CONSUMO_PALLET
  DEVUELTO_PALLET
  AJUSTE
  MERMA
}

model BoxMovement {
  id          String          @id @default(cuid())
  boxTypeId   String
  boxType     BoxType         @relation(fields: [boxTypeId], references: [id])
  date        DateTime
  quantity    Decimal         @db.Decimal(14, 3)
  type        BoxMovementType
  reason      String
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([boxTypeId])
}

enum PalletStatus {
  ARMADO
  DESARMADO
}

model Pallet {
  id           String       @id @default(cuid())
  label        String?
  date         DateTime
  woodItemId   String
  woodItem     Item         @relation("PalletWood", fields: [woodItemId], references: [id])
  filmItemId   String
  filmItem     Item         @relation("PalletFilm", fields: [filmItemId], references: [id])
  filmQuantity Decimal      @db.Decimal(14, 3)
  status       PalletStatus @default(ARMADO)
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())
  dismantledAt DateTime?

  boxes PalletBox[]
}

model PalletBox {
  id        String  @id @default(cuid())
  palletId  String
  pallet    Pallet  @relation(fields: [palletId], references: [id], onDelete: Cascade)
  boxTypeId String
  boxType   BoxType @relation(fields: [boxTypeId], references: [id])
  quantity  Decimal @db.Decimal(14, 3)
}

model Price {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id])
  circuit     Circuit
  amount      Decimal  @db.Decimal(14, 2)
  currency    Currency @default(ARS)
  validFrom   DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([productId, entityId, circuit, validFrom])
  @@index([productId, entityId, circuit])
}
