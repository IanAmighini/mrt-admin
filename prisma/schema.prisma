generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  SOLO_LECTURA
  SECRETARIA
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents Document[]
  payments  Payment[]

  itemMovements    ItemMovement[]
  productMovements ProductMovement[]
  productionRuns   ProductionRun[]
  prices           Price[]
  pedidos          Pedido[]
  auditLogs        AuditLog[]
  entregasPreforma EntregaPreforma[]
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/**
 * Registro de actividad: quién hizo qué. El resumen se arma y se guarda en el momento, para que
 * el log siga siendo legible aunque el registro original (Document, Payment, etc.) cambie o se
 * borre después.
 */
model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String?
  summary    String
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

enum EntityType {
  CLIENTE
  PROVEEDOR
  AMBOS
  TESORERIA
}

/**
 * Categoría de un movimiento de tesorería (Document tipo AJUSTE en la cuenta de una Entity
 * TESORERIA). COBRO/PAGO_PROVEEDOR se generan solos desde un Payment; el resto se carga a mano
 * desde "+ Movimiento".
 */
enum TreasuryMovementCategory {
  COBRO
  PAGO_PROVEEDOR
  GASTO_BANCARIO
  IMPUESTO
  RETIRO
  DEPOSITO
  AJUSTE_ARQUEO
  OTRO
}

enum SupplierCategory {
  ACEITE
  ENVASES
  CAJAS
  TAPAS
  CINTA
  ETIQUETAS
  PALLET_NORMALIZADO
  OTRO
}

model Entity {
  id                 String            @id @default(cuid())
  slug               String            @unique
  name               String
  type               EntityType
  taxId              String?
  email              String?
  phone              String?
  address            String?
  notes              String?
  supplierCategory   SupplierCategory?
  isWithholdingAgent Boolean           @default(false)
  /// Si es true, la ficha muestra la cuenta de preformas: este proveedor fía la preforma y cobra
  /// sólo el soplado, así que además de la cuenta en pesos se le deben preformas en unidades.
  llevaCuentaPreformas Boolean         @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  accounts           Account[]
  prices             Price[]
  pedidos            Pedido[]
  treasuryPayments   Payment[]
  entregasPreforma   EntregaPreforma[]
}

enum Circuit {
  BLANCO
  NEGRO
}

model Account {
  id        String   @id @default(cuid())
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id])
  circuit   Circuit
  createdAt DateTime @default(now())

  documents Document[]
  payments  Payment[]

  @@unique([entityId, circuit])
}

enum DocumentType {
  REMITO
  FACTURA
  NOTA_CREDITO
  NOTA_DEBITO
  AJUSTE
}

enum Currency {
  ARS
  USD
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  ECHEQ
  OTRO
}

model Document {
  id               String       @id @default(cuid())
  accountId        String
  account          Account      @relation(fields: [accountId], references: [id])
  type             DocumentType
  number           String
  date             DateTime
  dueDate          DateTime?
  currency         Currency     @default(ARS)
  exchangeRate     Decimal?     @db.Decimal(12, 4)
  netAmount        Decimal      @db.Decimal(14, 2)
  ivaRate          Decimal?     @db.Decimal(5, 2)
  ivaAmount        Decimal?     @db.Decimal(14, 2)
  retentionAmount  Decimal?     @db.Decimal(14, 2)
  perceptionAmount Decimal?     @db.Decimal(14, 2)
  totalAmount      Decimal      @db.Decimal(14, 2)
  reason           String?
  productId        String?
  product          Product?     @relation(fields: [productId], references: [id])
  quantity         Decimal?     @db.Decimal(14, 3)
  createdById      String
  createdBy        User         @relation(fields: [createdById], references: [id])
  createdAt        DateTime     @default(now())

  /**
   * Solo para AJUSTE en la cuenta de una Entity TESORERIA: qué tipo de movimiento es.
   */
  treasuryCategory TreasuryMovementCategory?
  /**
   * Si este AJUSTE se generó solo a partir de un cobro/pago (no cargado a mano), el Payment que
   * lo originó — con cascade, al borrar ese Payment este Document se borra solo.
   */
  sourcePaymentId  String?                   @unique
  sourcePayment    Payment?                  @relation("PaymentTreasuryDocument", fields: [sourcePaymentId], references: [id], onDelete: Cascade)

  remitoLinks   DocumentLink[]      @relation("RemitoLinks")
  facturaLinks  DocumentLink[]      @relation("FacturaLinks")
  allocations   PaymentAllocation[]
  lines         DocumentLine[]
  purchaseLines PurchaseLine[]
  itemMovements ItemMovement[]

  @@index([accountId])
}

model DocumentLine {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(14, 3)
  unitPrice  Decimal  @db.Decimal(14, 2)
  subtotal   Decimal  @db.Decimal(14, 2)

  productMovements ProductMovement[]

  @@index([documentId])
  @@index([productId])
}

model PurchaseLine {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  quantity   Decimal  @db.Decimal(14, 3)
  /// Cuatro decimales y no dos: cuando el precio se pacta en U$S, 0,1483 x 1.481,50 = 219,7065 y
  /// redondear a 219,71 corre el total del remito varios pesos.
  unitPrice  Decimal  @db.Decimal(14, 4)
  /// Precio pactado en U$S por unidad, cuando lo hay. `unitPrice` es este por la cotización del
  /// remito; se guarda el original porque es el que no se mueve y con el que se controla la cuenta.
  unitPriceUsd Decimal? @db.Decimal(14, 6)
  subtotal   Decimal  @db.Decimal(14, 2)

  @@index([documentId])
  @@index([itemId])
}

model DocumentLink {
  id        String   @id @default(cuid())
  remitoId  String
  remito    Document @relation("RemitoLinks", fields: [remitoId], references: [id])
  facturaId String
  factura   Document @relation("FacturaLinks", fields: [facturaId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)

  @@unique([remitoId, facturaId])
  @@index([facturaId])
}

model Payment {
  id          String        @id @default(cuid())
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id])
  date        DateTime
  amount      Decimal       @db.Decimal(14, 2)
  currency    Currency      @default(ARS)
  method      PaymentMethod
  reference   String?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  /**
   * A qué tesorería fue (cobro) o de dónde salió (pago a proveedor) la plata de este pago.
   */
  treasuryId      String?
  treasury        Entity? @relation(fields: [treasuryId], references: [id])
  /**
   * Cuando un cobro se asignó "directo a un proveedor", conecta el Payment del cobro con el
   * Payment del pago generado en la cuenta del proveedor (y viceversa). Sin relation formal a
   * propósito — el borrado en cascada de la pareja se maneja a mano en la acción.
   */
  linkedPaymentId String?

  allocations      PaymentAllocation[]
  treasuryDocument Document?           @relation("PaymentTreasuryDocument")

  @@index([accountId])
  @@index([treasuryId])
}

model PaymentAllocation {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id])
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())

  @@unique([paymentId, documentId])
  @@index([documentId])
}

model Item {
  id           String           @id @default(cuid())
  slug         String           @unique
  name         String
  unit         String
  category     SupplierCategory @default(OTRO)
  isResellable Boolean          @default(false)
  minStock     Decimal?         @db.Decimal(14, 3)
  unitCost     Decimal?         @db.Decimal(14, 2)
  /// Sólo envases: qué preforma consume. De acá sale a qué cuenta de preformas suma cada unidad
  /// recibida del proveedor que las fía.
  preformaId   String?
  preforma     Preforma?        @relation(fields: [preformaId], references: [id])
  /// Sólo envases: cuántas unidades trae el pallet descartable con el que los entrega el proveedor.
  /// Es un factor para cargar el remito — ese pallet no es el normalizado y no entra a stock.
  unitsPerPallet Int?
  /// Último precio de soplado pactado, en U$S por unidad. Lo propone el formulario de compra y se
  /// actualiza con lo que se cargue: los envases lo tienen fijo, las tapas lo mueven seguido.
  precioSopladoUsd Decimal?      @db.Decimal(14, 6)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  movements     ItemMovement[]
  recipeLines   RecipeItem[]
  purchaseLines PurchaseLine[]

  @@index([preformaId])
}

enum ItemMovementType {
  INGRESO
  CONSUMO_PRODUCCION
  CONSUMO_PALLET
  AJUSTE
  MERMA
  VENTA
}

model ItemMovement {
  id               String           @id @default(cuid())
  itemId           String
  item             Item             @relation(fields: [itemId], references: [id])
  date             DateTime
  quantity         Decimal          @db.Decimal(14, 3)
  type             ItemMovementType
  reason           String
  sourceKg         Decimal?         @db.Decimal(14, 3)
  conversionFactor Decimal?         @db.Decimal(10, 4)
  documentId       String?
  document         Document?        @relation(fields: [documentId], references: [id])
  productionLineId String?
  productionLine   ProductionLine?  @relation(fields: [productionLineId], references: [id], onDelete: Cascade)
  createdById      String
  createdBy        User             @relation(fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())

  @@index([itemId])
  @@index([documentId])
  @@index([productionLineId])
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  oilType          String
  presentation     String
  boxesPerPallet   Int?
  unitsPerBox      Int?
  bottleCapacityMl Decimal? @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recipe          RecipeItem[]
  movements       ProductMovement[]
  productionLines ProductionLine[]
  documents       Document[]
  documentLines   DocumentLine[]
  prices          Price[]
  pedidoLines     PedidoLine[]
}

/**
 * Marca (nombre + tipo de aceite), sin formato — catálogo reutilizable al crear productos.
 */
model Marca {
  id      String @id @default(cuid())
  name    String
  oilType String
  /// Si es false, la receta que se arma sola no lleva línea de etiqueta. Es el caso de "Sin
  /// etiqueta", que es producto terminado sin etiquetar. Para el resto, que falte la etiqueta es
  /// un error que hay que avisar, no algo que se pueda ignorar en silencio.
  usaEtiqueta Boolean @default(true)
  createdAt   DateTime @default(now())

  @@unique([name, oilType])
}

/**
 * Formato de pallet (cajas x botellas por caja x ml), universal — se define una vez y
 * cualquier marca lo puede reusar al crear un producto, sin volver a tipear los números.
 */
model Formato {
  id               String   @id @default(cuid())
  presentation     String   @unique
  boxesPerPallet   Int
  unitsPerBox      Int
  bottleCapacityMl Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model RecipeItem {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item    @relation(fields: [itemId], references: [id])
  quantityPerUnit Decimal @db.Decimal(14, 4)

  @@unique([productId, itemId])
}

enum ProductMovementType {
  PRODUCCION
  CONSUMO_ARMADO_CAJA
  AJUSTE
  MERMA
  ENTREGA
}

model ProductMovement {
  id               String              @id @default(cuid())
  productId        String
  product          Product             @relation(fields: [productId], references: [id])
  date             DateTime
  quantity         Decimal             @db.Decimal(14, 3)
  type             ProductMovementType
  reason           String
  productionLineId String?
  productionLine   ProductionLine?     @relation(fields: [productionLineId], references: [id], onDelete: Cascade)
  documentLineId   String?
  documentLine     DocumentLine?       @relation(fields: [documentLineId], references: [id], onDelete: Cascade)
  createdById      String
  createdBy        User                @relation(fields: [createdById], references: [id])
  createdAt        DateTime            @default(now())

  @@index([productId])
  @@index([productionLineId])
  @@index([documentLineId])
}

model ProductionRun {
  id          String   @id @default(cuid())
  date        DateTime
  notes       String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  lines ProductionLine[]
}

model ProductionLine {
  id              String        @id @default(cuid())
  productionRunId String
  productionRun   ProductionRun @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(14, 3)

  itemMovements    ItemMovement[]
  productMovements ProductMovement[]

  @@index([productionRunId])
  @@index([productId])
}

model Price {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id])
  circuit     Circuit
  amount      Decimal  @db.Decimal(14, 2)
  currency    Currency @default(ARS)
  validFrom   DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([productId, entityId, circuit, validFrom])
  @@index([productId, entityId, circuit])
}

enum PedidoStatus {
  EN_COLA
  COMPLETADO
  ENTREGADO
}

model Pedido {
  id           String       @id @default(cuid())
  date         DateTime
  entityId     String
  entity       Entity       @relation(fields: [entityId], references: [id])
  orderNumber  String
  status       PedidoStatus @default(EN_COLA)
  deliveryDate DateTime?
  comments     String?
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  lines PedidoLine[]

  @@index([entityId])
}

model PedidoLine {
  id        String  @id @default(cuid())
  pedidoId  String
  pedido    Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  pallets   Decimal @db.Decimal(14, 3)

  @@index([pedidoId])
  @@index([productId])
}

/// Tipo de preforma PET. Agrupa formatos que usan la misma: 850 y 900 comparten una, 4000 y 5000
/// otra. La deuda con el proveedor que las fía se lleva por tipo, no por formato.
model Preforma {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  items    Item[]
  entregas EntregaPreforma[]
}

/// Preformas entregadas al proveedor que las fía, para bajar lo que se le debe. Se compran a otro
/// proveedor y se entregan directo, sin pasar por el depósito, así que no hay movimiento de stock.
model EntregaPreforma {
  id          String   @id @default(cuid())
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id])
  preformaId  String
  preforma    Preforma @relation(fields: [preformaId], references: [id])
  date        DateTime
  quantity    Decimal  @db.Decimal(14, 3)
  comprobante String?
  notes       String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([entityId])
  @@index([preformaId])
}
