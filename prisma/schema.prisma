generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  CARGA_DIARIA
  SOLO_LECTURA
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents Document[]
  payments  Payment[]
}

enum EntityType {
  CLIENTE
  PROVEEDOR
  AMBOS
}

model Entity {
  id                 String     @id @default(cuid())
  name               String
  type               EntityType
  taxId              String?
  contact            String?
  isWithholdingAgent Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  accounts           Account[]
}

enum Circuit {
  BLANCO
  NEGRO
}

model Account {
  id        String   @id @default(cuid())
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id])
  circuit   Circuit
  createdAt DateTime @default(now())

  documents Document[]
  payments  Payment[]

  @@unique([entityId, circuit])
}

enum DocumentType {
  REMITO
  FACTURA
  NOTA_CREDITO
  NOTA_DEBITO
  AJUSTE
}

enum Currency {
  ARS
  USD
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  OTRO
}

model Document {
  id               String       @id @default(cuid())
  accountId        String
  account          Account      @relation(fields: [accountId], references: [id])
  type             DocumentType
  number           String
  date             DateTime
  dueDate          DateTime?
  currency         Currency     @default(ARS)
  exchangeRate     Decimal?     @db.Decimal(12, 4)
  netAmount        Decimal      @db.Decimal(14, 2)
  ivaRate          Decimal?     @db.Decimal(5, 2)
  ivaAmount        Decimal?     @db.Decimal(14, 2)
  retentionAmount  Decimal?     @db.Decimal(14, 2)
  perceptionAmount Decimal?     @db.Decimal(14, 2)
  totalAmount      Decimal      @db.Decimal(14, 2)
  reason           String?
  createdById      String
  createdBy        User         @relation(fields: [createdById], references: [id])
  createdAt        DateTime     @default(now())

  remitoLinks  DocumentLink[] @relation("RemitoLinks")
  facturaLinks DocumentLink[] @relation("FacturaLinks")
  allocations  PaymentAllocation[]

  @@index([accountId])
}

model DocumentLink {
  id        String   @id @default(cuid())
  remitoId  String
  remito    Document @relation("RemitoLinks", fields: [remitoId], references: [id])
  facturaId String
  factura   Document @relation("FacturaLinks", fields: [facturaId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)

  @@unique([remitoId, facturaId])
}

model Payment {
  id          String        @id @default(cuid())
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id])
  date        DateTime
  amount      Decimal       @db.Decimal(14, 2)
  currency    Currency      @default(ARS)
  method      PaymentMethod
  reference   String?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  allocations PaymentAllocation[]

  @@index([accountId])
}

model PaymentAllocation {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id])
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())

  @@unique([paymentId, documentId])
}
